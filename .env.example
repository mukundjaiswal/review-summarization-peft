# Copy to .env and fill in. .env is gitignored and must never be committed.

REVIEW_HF_TOKEN=

# 4-bit base model for QLoRA, and the instruction-tuned chat model used for the
# prompting-only baseline.
REVIEW_BASE_MODEL=unsloth/llama-2-7b-bnb-4bit
REVIEW_CHAT_MODEL=meta-llama/Llama-2-13b-chat-hf

REVIEW_OUTPUT_DIR=./outputs
REVIEW_MAX_SEQ_LENGTH=2048

# LoRA
REVIEW_LORA_R=16
REVIEW_LORA_ALPHA=16
REVIEW_LORA_DROPOUT=0

# Training
REVIEW_LEARNING_RATE=2e-4
REVIEW_MAX_STEPS=60
REVIEW_BATCH_SIZE=2
REVIEW_GRAD_ACCUM=4

# The eval slice must be identical across base and tuned runs, so this seed is
# load-bearing: change it and the comparison is no longer controlled.
REVIEW_SEED=42
REVIEW_EVAL_SIZE=100

REVIEW_LOG_LEVEL=INFO
